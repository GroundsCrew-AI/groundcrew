#!/usr/bin/env bash
# Groundcrew's secrets on the platform host: root-only files in /etc/groundcrew (0600), read by
# Compose when the services start. Never in images, git, Terraform state, or logs.
#
#   gc-secrets init                  make the files and fresh random keys (once; keeps existing)
#   gc-secrets set NAME              read a value from stdin (no echo) into the right file(s)
#   gc-secrets set-file github-app.pem   read the GitHub App private key from stdin
#   gc-secrets check                 which names are set (names only, never values)
#
# Rotation: docs/operations.md, Rotate secrets.
set -euo pipefail
umask 077
DIR=/etc/groundcrew
APP=$DIR/app.env
WEB=$DIR/web.env
PG=$DIR/postgres.env

# Where each value goes: app (API and worker), web, or both.
declare -A WHERE=(
  [INTERNAL_JWT_SECRET]=both [GITHUB_APP_CLIENT_ID]=both [GITHUB_APP_CLIENT_SECRET]=both
  [AUTH_SECRET]=web [AUTH_GITHUB_ID]=web [AUTH_GITHUB_SECRET]=web
  [NEXT_PUBLIC_API_URL]=web [AUTH_URL]=web [GOOGLE_AUTH_ENABLED]=both
)

need_root() { [ "$(id -u)" = 0 ] || { echo "run as root (sudo)" >&2; exit 1; }; }
rand() { openssl rand -base64 "$1" | tr -d '\n=+/' | cut -c1-"$2"; }
fernet() { python3 -c 'import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'; }

put() { # put FILE NAME VALUE: replace or add one line, keep the file 0600 root
  local file=$1 name=$2 value=$3 tmp
  tmp=$(mktemp "$DIR/.tmp.XXXXXX")
  { [ -f "$file" ] && grep -v "^${name}=" "$file" || true; printf '%s=%s\n' "$name" "$value"; } >"$tmp"
  chmod 0600 "$tmp"; chown root:root "$tmp"; mv "$tmp" "$file"
}
has() { [ -f "$1" ] && grep -q "^$2=" "$1"; }

init() {
  need_root
  install -d -m 0700 -o root -g root "$DIR"
  touch "$APP" "$WEB" "$PG"; chmod 0600 "$APP" "$WEB" "$PG"
  local domain=${GC_DOMAIN:-groundkrew.com} api=${GC_API_DOMAIN:-api.groundkrew.com}
  has "$PG" POSTGRES_PASSWORD || put "$PG" POSTGRES_PASSWORD "$(rand 48 40)"
  local pg; pg=$(grep '^POSTGRES_PASSWORD=' "$PG" | cut -d= -f2-)
  put "$APP" DATABASE_URL "postgresql+asyncpg://groundcrew:${pg}@postgres:5432/groundcrew"
  has "$APP" SECRETS_KEY || put "$APP" SECRETS_KEY "$(fernet)"
  has "$APP" APPROVAL_TOKEN_KEY || put "$APP" APPROVAL_TOKEN_KEY "$(rand 64 64)"
  if ! has "$APP" INTERNAL_JWT_SECRET; then
    local jwt; jwt=$(rand 64 64); put "$APP" INTERNAL_JWT_SECRET "$jwt"; put "$WEB" INTERNAL_JWT_SECRET "$jwt"
  fi
  has "$WEB" AUTH_SECRET || put "$WEB" AUTH_SECRET "$(rand 48 44)"
  # Not secret, but kept with the rest so one place says how this host is configured.
  has "$APP" WEB_ORIGIN || put "$APP" WEB_ORIGIN "https://$domain"
  has "$APP" GROUNDCREW_PLATFORM_PRINCIPAL_ARN \
    || put "$APP" GROUNDCREW_PLATFORM_PRINCIPAL_ARN "arn:aws:iam::881050425883:role/groundcrew-platform"
  has "$APP" EMAIL_FROM || put "$APP" EMAIL_FROM "Groundcrew <no-reply@$domain>"
  has "$WEB" AUTH_URL || put "$WEB" AUTH_URL "https://$domain"
  has "$WEB" NEXT_PUBLIC_API_URL || put "$WEB" NEXT_PUBLIC_API_URL "https://$api"
  # Compose mounts the GitHub App key as a file; without one it would make a directory there.
  [ -e "$DIR/github-app.pem" ] || { install -m 0400 -o 10001 -g 10001 /dev/null "$DIR/github-app.pem"; }
  echo "gc-secrets: $DIR ready. Add the values you hold with: gc-secrets set NAME"
  check
}

set_value() {
  need_root
  local name=$1 value
  [[ "$name" =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "not a setting name: $name" >&2; exit 2; }
  if [ -t 0 ]; then read -r -s -p "$name: " value; echo; else IFS= read -r value; fi
  [ -n "$value" ] || { echo "empty value, nothing changed" >&2; exit 1; }
  case "${WHERE[$name]:-app}" in
    app) put "$APP" "$name" "$value" ;;
    web) put "$WEB" "$name" "$value" ;;
    both) put "$APP" "$name" "$value"; put "$WEB" "$name" "$value" ;;
  esac
  echo "gc-secrets: $name set (${WHERE[$name]:-app}). Restart the services to use it: gc-status restart"
}

set_file() {
  need_root
  [ "$1" = github-app.pem ] || { echo "only github-app.pem" >&2; exit 2; }
  local tmp; tmp=$(mktemp "$DIR/.tmp.XXXXXX"); cat >"$tmp"
  grep -q "BEGIN .*PRIVATE KEY" "$tmp" || { rm -f "$tmp"; echo "that is not a PEM private key" >&2; exit 1; }
  # The one file a container reads directly: owned by the app user (10001), read-only.
  chown 10001:10001 "$tmp"; chmod 0400 "$tmp"; mv "$tmp" "$DIR/github-app.pem"
  put "$APP" GITHUB_APP_PRIVATE_KEY_PATH /run/secrets/github-app.pem
  echo "gc-secrets: github-app.pem installed"
}

check() {
  local f
  for f in "$APP" "$WEB" "$PG"; do
    [ -f "$f" ] || continue
    echo "$(basename "$f"): $(cut -d= -f1 "$f" | sort | tr '\n' ' ')"
  done
  [ -s "$DIR/github-app.pem" ] && echo "github-app.pem: present" || echo "github-app.pem: not set"
}

case "${1:-}" in
  init) init ;;
  set) set_value "${2:?NAME}" ;;
  set-file) set_file "${2:?file}" ;;
  check) need_root; check ;;
  *) sed -n '2,12p' "$0"; exit 2 ;;
esac
