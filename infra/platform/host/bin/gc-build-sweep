#!/usr/bin/env bash
# Remove what builds left behind in the build daemon: containers older than two hours (a
# worker that died mid-build), their builders, unused images older than a day, and dangling
# volumes. Runs as gcbuild from gc-build-sweep.timer.
set -euo pipefail
as_build() {
  sudo -u gcbuild env XDG_RUNTIME_DIR=/run/user/1500 HOME=/var/lib/gcbuild-home \
    DOCKER_HOST=unix:///run/user/1500/docker.sock BUILDX_CONFIG=/var/lib/gcbuild-home/.buildx "$@"
}
cutoff=$(( $(date +%s) - 7200 ))
# CreatedAt looks like "2026-10-21 12:58:00 +0000 UTC".
as_build docker ps -a --filter label=groundcrew=1 --format '{{.ID}}|{{.CreatedAt}}' |
while IFS='|' read -r id created; do
  ts=$(date -d "${created% UTC}" +%s 2>/dev/null || echo 0)
  if [ "$ts" -gt 0 ] && [ "$ts" -lt "$cutoff" ]; then
    as_build docker rm --force --volumes "$id" >/dev/null && echo "removed container $id"
  fi
done
as_build docker image prune --all --force --filter "until=24h" >/dev/null
as_build docker volume prune --all --force >/dev/null
echo "gc-build-sweep: done"
