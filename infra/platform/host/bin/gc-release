#!/usr/bin/env bash
# Releases on the platform host, built here from source (no registry, no repo credentials).
#
#   gc-release deploy <sha> < source.tar    unpack, build groundcrew/api:<sha> and
#                                          groundcrew/web:<sha>, migrate, roll out
#   gc-release rollback [<sha>]            back to the previous release (or <sha>)
#   gc-release list                        releases on this host, the current one marked
#
# Roll-out: migrations first (they must be additive, so the running release keeps working),
# then worker, api, web one at a time, each until healthy. If anything fails, the previous
# images go back the same way. The last 3 releases' images are kept.
# Non-secret settings come from /etc/groundcrew/config.env; secrets from gc-secrets.
set -euo pipefail
cd /opt/groundcrew
STATE=/var/lib/groundcrew/releases
SRC=/var/lib/groundcrew/src
KEEP=3
API_URL=$(grep -h '^NEXT_PUBLIC_API_URL=' /etc/groundcrew/web.env 2>/dev/null | cut -d= -f2- || true)
compose() { docker compose --env-file /opt/groundcrew/release.env -f /opt/groundcrew/compose.yml "$@"; }
log() { echo "[gc-release] $*"; }

current() { grep -h '^GC_RELEASE=' /opt/groundcrew/release.env 2>/dev/null | cut -d= -f2- || true; }

write_env() { # write_env SHA
  local tmp; tmp=$(mktemp /opt/groundcrew/.release.XXXXXX)
  cat >"$tmp" <<ENV
GC_RELEASE=$1
GC_API_IMAGE=groundcrew/api:$1
GC_WEB_IMAGE=groundcrew/web:$1
GC_POSTGRES_IMAGE=${GC_POSTGRES_IMAGE:-pgvector/pgvector:pg16}
ENV
  chmod 0644 "$tmp"; mv "$tmp" /opt/groundcrew/release.env
}

healthy() { # healthy SERVICE SECONDS
  local id status deadline=$(( $(date +%s) + $2 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    id=$(compose ps -q "$1" 2>/dev/null || true)
    status=$( [ -n "$id" ] && docker inspect -f '{{.State.Health.Status}}' "$id" 2>/dev/null || echo none)
    [ "$status" = healthy ] && return 0
    [ "$status" = unhealthy ] && return 1
    sleep 3
  done
  return 1
}

roll_out() { # roll_out SHA [migrate|no-migrate]: each service until healthy
  write_env "$1"
  install -m 0644 "$STATE/compose-$1.yml" /opt/groundcrew/compose.yml
  compose up -d postgres
  healthy postgres 120 || { log "postgres is not healthy"; return 1; }
  # The Groundcrew registry (releases from the agent deploys on); older releases have none.
  if compose config --services | grep -qx registry; then
    compose up -d registry
    healthy registry 60 || { log "registry is not healthy"; return 1; }
  fi
  if [ "${2:-migrate}" = migrate ]; then
    log "migrations"
    compose run --rm --no-deps migrate || { log "migrations failed"; return 1; }
  else
    # Migrations are additive: an older release runs on the newer schema; it never downgrades.
    log "no migrations (going back)"
  fi
  local s
  for s in worker api web; do
    compose up -d --no-deps --force-recreate "$s"
    if healthy "$s" 180; then log "$s healthy"; else log "$s did not become healthy"; return 1; fi
  done
  # Over nginx, as users reach it (only once a certificate exists).
  if [ -f /etc/nginx/sites-enabled/groundcrew.conf ]; then
    local domain api
    domain=$(grep -h '^WEB_ORIGIN=' /etc/groundcrew/app.env | sed 's#.*://##')
    api=${API_URL#https://}
    curl -fsS -m 10 --resolve "$api:443:127.0.0.1" "https://$api/ready" >/dev/null \
      || { log "https://$api/ready failed"; return 1; }
    curl -fsS -m 10 -o /dev/null --resolve "$domain:443:127.0.0.1" "https://$domain/api/health" \
      || { log "https://$domain/api/health failed"; return 1; }
    log "HTTPS checks passed"
  fi
}

build() { # build SHA < tar
  local sha=$1 dir=$SRC/$1
  [[ "$sha" =~ ^[0-9a-f]{7,40}$ ]] || { echo "not a commit sha: $sha" >&2; exit 2; }
  [ -n "$API_URL" ] || { echo "NEXT_PUBLIC_API_URL is not set in web.env (gc-secrets init)" >&2; exit 1; }
  rm -rf "$dir"; install -d -m 0700 "$dir"
  tar -x -C "$dir"
  log "building groundcrew/api:$sha"
  docker build -q --label "groundcrew.release=$sha" -t "groundcrew/api:$sha" "$dir/apps/api" >/dev/null
  log "building groundcrew/web:$sha"
  # The web image also builds and serves the Groundcrew agent (apps/agent) at /agent/.
  docker build -q --label "groundcrew.release=$sha" --build-arg "NEXT_PUBLIC_API_URL=$API_URL" \
    --build-context "agent-src=$dir/apps/agent" \
    -t "groundcrew/web:$sha" "$dir/apps/web" >/dev/null
  # The agent's container image (Kubernetes, ECS), both CPUs, published after the roll-out.
  local arch
  for arch in amd64 arm64; do
    # No provenance or SBOM attestations: each push stays one image, so the image list can name them.
    docker build -q --provenance=false --sbom=false --label "groundcrew.release=$sha" \
      --platform "linux/$arch" --target agent-image \
      --build-arg "NEXT_PUBLIC_API_URL=$API_URL" --build-context "agent-src=$dir/apps/agent" \
      -t "groundcrew/agent:$sha-$arch" "$dir/apps/web" >/dev/null
  done
  install -d -m 0700 "$STATE"
  tr -d '[:space:]' <"$dir/apps/agent/VERSION" >"$STATE/agent-version-$sha"
  # Each release brings its own Compose file; going back uses the old one.
  install -d -m 0700 "$STATE"
  install -m 0644 "$dir/infra/platform/host/compose.yml" "$STATE/compose-$sha.yml"
  rm -rf "$dir"
}

record() { # record SHA: newest first, unique
  install -d -m 0700 "$STATE"
  { echo "$1 $(date -u +%FT%TZ)"; grep -v "^$1 " "$STATE/history" 2>/dev/null || true; } >"$STATE/history.new"
  mv "$STATE/history.new" "$STATE/history"
}

publish_agent() { # publish_agent SHA: the agent image at <domain>/public/groundcrew-agent:<version>
  local sha=$1 version repo=127.0.0.1:5000/public/groundcrew-agent arch refs=()
  version=$(cat "$STATE/agent-version-$sha" 2>/dev/null) || { log "no agent image in $sha"; return 0; }
  for arch in amd64 arm64; do
    docker tag "groundcrew/agent:$sha-$arch" "$repo:$version-$arch" &&
      docker push -q "$repo:$version-$arch" >/dev/null || { log "agent image $arch not published"; return 1; }
    refs+=("$repo:$version-$arch")
  done
  docker manifest rm "$repo:$version" >/dev/null 2>&1 || true
  docker manifest create --insecure "$repo:$version" "${refs[@]}" >/dev/null &&
    docker manifest push --insecure --purge "$repo:$version" >/dev/null || { log "agent image list not published"; return 1; }
  log "agent image $version published"
}

prune() { # keep the images of the last $KEEP releases
  local keep sha
  keep=$(head -n "$KEEP" "$STATE/history" | cut -d' ' -f1)
  for sha in $(docker images --filter label=groundcrew.release --filter reference='groundcrew/api' --format '{{.Tag}}' | sort -u); do
    echo "$keep" | grep -qx "$sha" && continue
    docker rmi -f "groundcrew/api:$sha" "groundcrew/web:$sha" "groundcrew/agent:$sha-amd64" \
      "groundcrew/agent:$sha-arm64" >/dev/null 2>&1 || true
    rm -f "$STATE/compose-$sha.yml" "$STATE/agent-version-$sha"
    log "removed release $sha"
  done
}

deploy() {
  local sha=$1 previous; previous=$(current)
  build "$sha"
  log "rolling out $sha (previous: ${previous:-none})"
  if roll_out "$sha"; then
    record "$sha"; prune; log "release $sha is live"
    # A failed publish leaves the release live; the previous agent image stays where it was.
    publish_agent "$sha" || log "WARNING: the agent image was not published (Kubernetes and ECS installs keep the previous one)"
  else
    if [ -n "$previous" ]; then
      log "rolling back to $previous"
      roll_out "$previous" no-migrate && log "back on $previous" || log "ROLLBACK ALSO FAILED: check gc-status"
    fi
    exit 1
  fi
}

rollback() {
  local target=${1:-} now; now=$(current)
  [ -n "$target" ] || target=$(grep -v "^$now " "$STATE/history" | head -1 | cut -d' ' -f1)
  [ -n "$target" ] || { echo "no earlier release on this host" >&2; exit 1; }
  docker image inspect "groundcrew/api:$target" "groundcrew/web:$target" >/dev/null \
    || { echo "images for $target are gone (only the last $KEEP are kept)" >&2; exit 1; }
  log "rolling back from ${now:-none} to $target"
  if roll_out "$target" no-migrate; then record "$target"; log "release $target is live"
  else log "rollback failed; returning to $now"; [ -n "$now" ] && roll_out "$now" no-migrate; exit 1; fi
}

case "${1:-}" in
  deploy) deploy "${2:?sha}" ;;
  rollback) rollback "${2:-}" ;;
  list) now=$(current); while read -r sha at; do echo "$([ "$sha" = "$now" ] && echo '*' || echo ' ') $sha $at"; done <"$STATE/history" ;;
  *) sed -n '2,15p' "$0"; exit 2 ;;
esac
