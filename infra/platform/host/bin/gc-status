#!/usr/bin/env bash
# What runs on the platform host, and a few operations.
#   gc-status              services, health, disk, build daemon, certificates
#   gc-status restart      restart worker, then api, then web, waiting for each to be healthy
#   gc-status logs NAME    the last 200 log lines of a service (journald)
set -euo pipefail
cd /opt/groundcrew
compose() { docker compose --env-file /opt/groundcrew/release.env -f /opt/groundcrew/compose.yml "$@"; }

healthy() { # healthy SERVICE TIMEOUT
  local id deadline=$(( $(date +%s) + $2 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    id=$(compose ps -q "$1")
    [ -n "$id" ] && [ "$(docker inspect -f '{{.State.Health.Status}}' "$id" 2>/dev/null)" = healthy ] && return 0
    sleep 3
  done
  return 1
}

case "${1:-}" in
  "")
    compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Health}}\t{{.Image}}'
    echo; df -h / /var/lib/gcbuild | tail -n +1
    echo; echo "build daemon: $(sudo -u gcbuild env XDG_RUNTIME_DIR=/run/user/1500 systemctl --user is-active docker)"
    echo "certificates:"; certbot certificates 2>/dev/null | grep -E "Domains|Expiry" || echo "  none yet"
    ;;
  restart)
    for s in worker api web; do
      compose up -d --no-deps --force-recreate "$s"
      healthy "$s" 180 || { echo "gc-status: $s is not healthy" >&2; exit 1; }
      echo "$s healthy"
    done
    ;;
  logs) journalctl CONTAINER_TAG="groundcrew-${2:?service}-1" -n 200 --no-pager ;;
  *) sed -n '2,5p' "$0"; exit 2 ;;
esac
