[Unit]
Description=Groundcrew host firewall rules (build egress, metadata access)
After=network-online.target docker.service
Wants=network-online.target
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/groundcrew/bin/gc-firewall apply

[Install]
WantedBy=multi-user.target docker.service
