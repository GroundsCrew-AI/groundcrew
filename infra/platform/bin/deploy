#!/usr/bin/env bash
# Deploy a commit to the platform host, from your machine:
#
#   GC_HOST=<server> infra/platform/bin/deploy <git-ref> [--yes]
#
# Sends the commit's source (git archive over SSH: the server needs no repository access),
# optionally the non-secret settings file (GC_CONFIG_FILE -> /etc/groundcrew/config.env), then
# runs `gc-release deploy <sha>` there: build the images on the server, migrate, roll out worker,
# api, web with health checks, and roll back automatically if a check fails.
#
# Settings: GC_HOST (required), GC_SSH_USER (ubuntu), GC_SSH_KEY (~/.ssh/id_ed25519),
# GC_CONFIG_FILE (optional).
set -euo pipefail
ref=${1:?usage: deploy <git-ref> [--yes]}
yes=${2:-}
host=${GC_HOST:?set GC_HOST}
user=${GC_SSH_USER:-ubuntu}
key=${GC_SSH_KEY:-$HOME/.ssh/id_ed25519}
ssh_=(ssh -i "$key" -o BatchMode=yes "$user@$host")

sha=$(git rev-parse --verify "$ref^{commit}")
short=${sha:0:12}
echo "Deploy $short ($(git log -1 --format='%s' "$sha")) to $host:"
echo "  1. ${GC_CONFIG_FILE:+copy $GC_CONFIG_FILE to /etc/groundcrew/config.env; }send the source of $short (git archive)"
echo "  2. build groundcrew/api:$short and groundcrew/web:$short on the server"
echo "  3. run migrations (additive), restart worker, api, web, each until healthy"
echo "  4. on any failure, go back to the release running now"
if [ "$yes" != --yes ]; then
  read -r -p "Go ahead? [y/N] " answer
  [ "$answer" = y ] || [ "$answer" = Y ] || { echo "Nothing changed."; exit 1; }
fi
if [ -n "${GC_CONFIG_FILE:-}" ]; then
  "${ssh_[@]}" "sudo install -m 0600 -o root -g root /dev/stdin /etc/groundcrew/config.env" <"$GC_CONFIG_FILE"
fi
git archive --format=tar "$sha" | "${ssh_[@]}" "sudo /opt/groundcrew/bin/gc-release deploy $short"
