#cloud-config
# First boot of the Groundcrew platform host: a hardened baseline. Docker, gVisor, the rootless
# build daemon, nginx, certbot, Postgres, and the app are installed by infra/platform/host/
# (docs/phase6-plan.md section 5). Runs once; changing it does not touch a running host.

hostname: groundcrew-platform
ssh_pwauth: false
disable_root: true
ssh_authorized_keys:
  - ${ssh_public_key}

package_update: true
package_upgrade: true
packages:
  - unattended-upgrades
  - fail2ban
  - ufw

write_files:
  - path: /etc/ssh/sshd_config.d/60-groundcrew.conf
    permissions: "0644"
    content: |
      # Key-only SSH for the ubuntu user (cloud-init installed its key).
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      AllowUsers ubuntu
      MaxAuthTries 3
      X11Forwarding no
  - path: /etc/apt/apt.conf.d/52groundcrew-upgrades
    permissions: "0644"
    content: |
      // Security updates install by themselves (the default security origin of
      // unattended-upgrades); a kernel update reboots at 04:00 UTC.
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "04:00";
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  - path: /etc/fail2ban/jail.d/groundcrew.local
    permissions: "0644"
    content: |
      [sshd]
      enabled = true
      maxretry = 5
      findtime = 10m
      bantime = 1h
  - path: /etc/sysctl.d/60-groundcrew.conf
    permissions: "0644"
    content: |
      vm.swappiness = 10

runcmd:
  # Host firewall matching the security group: 80 and 443 from anywhere, 22 from the admin
  # address only.
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw allow from ${admin_cidr} to any port 22 proto tcp
  - ufw --force enable
  - systemctl restart ssh
  - systemctl enable --now fail2ban unattended-upgrades
  # 4 GiB swap for a heavy build next to everything else.
  - fallocate -l 4G /swapfile
  - chmod 600 /swapfile
  - mkswap /swapfile
  - swapon /swapfile
  - echo '/swapfile none swap sw 0 0' >> /etc/fstab
  - sysctl --system
