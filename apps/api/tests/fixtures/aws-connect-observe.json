                    "Resource": "*",
                    "Sid": "Inventory"
                  },
                  {
                    "Action": [
                      "secretsmanager:GetSecretValue",
                      "ssm:GetParameter*",
                      "kms:Decrypt",
                      "s3:GetObject",
                      "s3:GetObjectVersion"
                    ],
                    "Effect": "Deny",
                    "Resource": "*",
                    "Sid": "NeverReadSecretValuesOrData"
                  }
                ],
                "Version": "2012-10-17"
              },
              "PolicyName": "groundcrew-read-only"
            }
          ],
          "RoleName": {
            "Ref": "RoleName"
          }
        },
        "Type": "AWS::IAM::Role"
      },
      "ResourceExplorerDefaultView": {
        "Properties": {
          "ViewArn": {
            "Ref": "ResourceExplorerView"
          }
        },
        "Type": "AWS::ResourceExplorer2::DefaultViewAssociation"
      },
      "ResourceExplorerIndex": {
        "Properties": {
          "Type": "LOCAL"
        },
        "Type": "AWS::ResourceExplorer2::Index"
      },
      "ResourceExplorerView": {
        "DependsOn": "ResourceExplorerIndex",
        "Properties": {
          "IncludedProperties": [
            {
              "Name": "tags"
            }
          ],
          "ViewName": "groundcrew-default"
        },
        "Type": "AWS::ResourceExplorer2::View"
      }
    }
  }
}
