    "/runs/{run_id}/events": {
      "get": {
        "description": "SSE: existing steps, then new ones and status changes until the run ends.\n\nEvents: `step`, `approval_requested`, `approval_decided` (id = step seq), `status`,\nand a final `done`. A heartbeat comment every 15 s keeps proxies from closing the\nconnection. Reconnects with Last-Event-ID (or ?after=) continue after that step.\n\nNo request-scoped session here: FastAPI closes it only after the stream ends, which\nwould hold a pooled connection idle in transaction for every open stream. Each poll\nuses its own short session instead.",
        "operationId": "run_events_runs__run_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "description": "Stream token from POST /runs/{id}/stream-token",
            "in": "query",
            "name": "token",
            "required": true,
            "schema": {
              "description": "Stream token from POST /runs/{id}/stream-token",
              "title": "Token",
              "type": "string"
            }
          },
          {
            "description": "Resume after this step seq (when the header can't be set)",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Resume after this step seq (when the header can't be set)",
              "title": "After"
            }
          },
          {
            "in": "header",
            "name": "last-event-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Events",
        "tags": [
          "runs"
        ]
      }
    },
