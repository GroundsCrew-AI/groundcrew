# The Groundcrew agent (installed by install.sh). It only connects out to Groundcrew.
[Unit]
Description=Groundcrew agent
Documentation=https://groundkrew.com/docs/connect/agent
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=groundcrew-agent
Group=groundcrew-agent
ExecStart=/usr/local/bin/groundcrew-agent run --config /etc/groundcrew-agent/agent.yaml
Restart=always
RestartSec=10
# Hardening: the agent writes only its state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
StateDirectory=groundcrew-agent
StateDirectoryMode=0700
ReadWritePaths=/var/lib/groundcrew-agent

[Install]
WantedBy=multi-user.target
