# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory OpenAI-compatible base URL (copy from https://docs.tokenfactory.nebius.com/)
TOKEN_FACTORY_BASE_URL=
# Nebius Token Factory API key (secret)
TOKEN_FACTORY_API_KEY=
# Exact Token Factory model ID for Nemotron 3 Nano (used by Scout)
MODEL_NANO=
# Exact Token Factory model ID for Nemotron 3 Super (used by Builder and Deployer)
MODEL_SUPER=
# Exact Token Factory model ID for Nemotron 3 Ultra (used by Medic)
MODEL_ULTRA=
# NVIDIA embedding model ID on Token Factory, if available
MODEL_EMBED=
# Tavily API key for web research (secret)
TAVILY_API_KEY=
# Postgres connection string (Neon), used from Phase 1
DATABASE_URL=
# Fernet key for encrypting stored secrets (secret)
SECRETS_KEY=
# GitHub App ID, used from Phase 3
GITHUB_APP_ID=
# GitHub App private key in PEM format (secret)
GITHUB_APP_PRIVATE_KEY=
# Max tokens all agents may use per day
DAILY_TOKEN_BUDGET=
# Max Nemotron Ultra calls allowed per incident
MAX_ULTRA_CALLS_PER_INCIDENT=

# Frontend: base URL of the API as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
