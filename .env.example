# Copy to .env and fill in. Never commit .env.
# Blank values mean "not set" and fall back to the defaults shown in comments.

# Nebius Token Factory OpenAI-compatible base URL (copy from https://docs.tokenfactory.nebius.com/)
TOKEN_FACTORY_BASE_URL=
# Nebius Token Factory API key (secret)
TOKEN_FACTORY_API_KEY=
# Exact Token Factory model ID for Nemotron 3 Nano (used by Scout)
MODEL_NANO=
# Exact Token Factory model ID for Nemotron 3 Super (used by Builder and Deployer)
MODEL_SUPER=
# Exact Token Factory model ID for Nemotron 3 Ultra (used by Medic)
MODEL_ULTRA=
# Nemotron 3.5 Lightning (default nvidia/Nemotron-3_5-Lightning). Its routes switch on once PRICE_LIGHTNING_* is set
MODEL_LIGHTNING=
# Embedding model (default Qwen/Qwen3-Embedding-8B, the only one on Token Factory; cut to EMBED_DIM)
MODEL_EMBED=
# Rerank model ID on Token Factory, e.g. Qwen/Qwen3-Reranker-8B (unset = rerank keeps input order)
MODEL_RERANK=
# Optional token for cloning private HTTPS repos (secret). Sent as a header via git's environment.
GIT_CLONE_TOKEN=
# Seconds before a git clone is stopped (default 120)
GIT_CLONE_TIMEOUT_SECONDS=
# Clones bigger than this many bytes are refused and deleted (default 300000000)
REPO_MAX_BYTES=
# Directory for temporary clones (default: the system temp dir); each clone is always deleted
REPO_WORKDIR=
# Vector size of incidents.embedding (default 1024). Changing it needs a new migration.
EMBED_DIM=
# Usable context per tier in tokens: the largest prompt it reads reliably. Bigger prompts go to the fallback tier.
# Defaults: Nano 8000 (accepts 65k but answers wrong from ~20k), Super 256000, Ultra 256000
LLM_CONTEXT_NANO=
LLM_CONTEXT_SUPER=
LLM_CONTEXT_ULTRA=
# Lightning's usable context in tokens (default 64000; read 60k-token prompts correctly)
LLM_CONTEXT_LIGHTNING=
# Timeout for one LLM call in seconds (default 120)
LLM_TIMEOUT_SECONDS=
# Tries per model on 429 / 5xx / connection errors (default 3; a timeout is retried once at most)
LLM_MAX_ATTEMPTS=
# Retry backoff base in seconds: base * 2**n plus jitter (default 1.0)
LLM_RETRY_BASE_SECONDS=
# Max completion tokens for generic agent-loop steps (Echo Ops); pipeline tasks set their own (default 4096)
LLM_MAX_TOKENS=
# Do not make a call if budgets leave fewer completion tokens than this (default 512)
LLM_MIN_COMPLETION_TOKENS=
# true = route Ultra tasks to Super to save Ultra credits (default false)
DEV_MODE_NO_ULTRA=

# Prices in USD per million tokens. Blank = the defaults below, which are UNVERIFIED (third-party
# listing): set the real ones from the Token Factory pricing page. Models with no price are never called.
# Defaults: Nano 0.06 / 0.24, Super 0.30 / 0.90, Ultra 1.00 / 3.00
PRICE_NANO_INPUT_PER_M=
PRICE_NANO_OUTPUT_PER_M=
PRICE_SUPER_INPUT_PER_M=
PRICE_SUPER_OUTPUT_PER_M=
PRICE_ULTRA_INPUT_PER_M=
PRICE_ULTRA_OUTPUT_PER_M=
# Lightning prices (no default). Setting both turns on its routes: tool_step, investigate_step, verify_recovery
PRICE_LIGHTNING_INPUT_PER_M=
PRICE_LIGHTNING_OUTPUT_PER_M=
# Embedding and rerank prices per million input tokens (no default: unset = never called)
PRICE_EMBED_PER_M=
PRICE_RERANK_PER_M=

# Spend caps in USD, counted in the llm_usage table. The total cap is the hard stop.
# Max spend in one run (default 0.40)
LLM_RUN_USD_CAP=
# Max spend per UTC day, all runs (default 2.00; set 0.50 on the hosted demo)
LLM_DAILY_USD_CAP=
# Max spend ever, all runs and scripts (default 25)
LLM_TOTAL_USD_CAP=

# Tavily API key for web research (secret)
TAVILY_API_KEY=
# Postgres URL for the hosted demo (Neon). Local dev and tests use the compose container instead.
DATABASE_URL=
# Fernet key for encrypting stored secrets (secret). Generate with: make keygen
SECRETS_KEY=

# GitHub App ID, used from Phase 3
GITHUB_APP_ID=
# GitHub App OAuth client ID
GITHUB_APP_CLIENT_ID=
# GitHub App OAuth client secret (secret)
GITHUB_APP_CLIENT_SECRET=
# Path to the GitHub App private key PEM file; keep it in secrets/ (git-ignored)
GITHUB_APP_PRIVATE_KEY_PATH=
# Secret used to verify GitHub webhook signatures (secret)
GITHUB_WEBHOOK_SECRET=

# Connections and discovery (Phase 3)
# Groundcrew's AWS platform identity: the IAM user groundcrew-platform, whose ONLY permission is
# sts:AssumeRole on arn:aws:iam::*:role/groundcrew-* (docs/self-hosting.md). It assumes each
# customer's read-only role with that workspace's ExternalId. Never a profile or ~/.aws; leave
# both keys empty on a host with a task or instance role. Customers' AWS keys are never stored.
GROUNDCREW_AWS_ACCESS_KEY_ID=
# (secret)
GROUNDCREW_AWS_SECRET_ACCESS_KEY=
# ARN of that identity, e.g. arn:aws:iam::881050425883:user/groundcrew-platform. Prefilled as the
# trusted principal in the Connect AWS link.
GROUNDCREW_PLATFORM_PRINCIPAL_ARN=
# S3 URL of infra/aws-connect.yaml for the one-click CloudFormation Quick-create link (CloudFormation
# only accepts S3 URLs). `make publish-connect-template` uploads it and prints the URL, e.g.
# https://groundcrew-templates-881050425883.s3.us-east-2.amazonaws.com/aws-connect.yaml
AWS_CONNECT_TEMPLATE_URL=
# Regions discovery may call, comma separated (default us-east-2; the demo account's org policy
# allows workloads only in us-east-2). IAM and STS are global and always allowed.
DISCOVERY_REGIONS=
# Discovery keeps at most this many resources per connection and says so (default 2000)
MAX_RESOURCES_PER_CONNECTION=
# Seconds one connection's discovery may take before it is stopped (default 100)
DISCOVERY_TIMEOUT_SECONDS=

# Max tokens all agents may use per UTC day (unset = no daily limit)
DAILY_TOKEN_BUDGET=
# Max Nemotron Ultra calls allowed per incident (unset = no limit)
MAX_ULTRA_CALLS_PER_INCIDENT=
# Max Nemotron Ultra calls in one run (default 3)
MAX_ULTRA_CALLS_PER_RUN=
# Max model calls in one agent run (default 12)
MAX_STEPS_PER_RUN=
# Max prompt + completion tokens in one agent run (default 400000)
MAX_TOKENS_PER_RUN=

# Seconds the worker waits between polls when the queue is empty (default 1.0)
WORKER_POLL_INTERVAL_SECONDS=
# Seconds without a worker heartbeat before a running job can be claimed again (default 600)
JOB_LOCK_TIMEOUT_SECONDS=
# On shutdown, seconds the current job may keep running before it is requeued (default 20)
WORKER_SHUTDOWN_GRACE_SECONDS=
# How often the SSE endpoint checks the DB for new run steps, in ms (default 500)
SSE_POLL_INTERVAL_MS=
# Python log level for api and worker (default INFO)
LOG_LEVEL=

# --- Auth (Phase 2) ---
# Shared by web and API: the web app signs a 5-minute HS256 JWT for every API call with it (secret).
# At least 32 characters. Generate with: openssl rand -base64 48
INTERNAL_JWT_SECRET=
# The web app's origin. The API allows CORS from it only, for the live run stream.
WEB_ORIGIN=http://localhost:3000
# Auth.js session encryption key (secret). Generate with: npx auth secret  (or openssl rand -base64 33)
AUTH_SECRET=
# GitHub OAuth for sign-in. Leave blank to use GITHUB_APP_CLIENT_ID / GITHUB_APP_CLIENT_SECRET above.
# The GitHub App needs the callback URL http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
# GitHub OAuth client secret (secret). Blank = GITHUB_APP_CLIENT_SECRET.
AUTH_GITHUB_SECRET=
# Where the web server reaches the API (server side only). Compose sets http://api:8000.
API_INTERNAL_URL=http://localhost:8000

# Frontend: base URL of the API as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
